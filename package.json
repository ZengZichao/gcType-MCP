{
  "name": "gctype-mcp",
  "version": "0.1.0",
  "description": "An MCP (Model Context Protocol) server for the gcType Type Strains Genome Database (https://gctype.wdcm.org/), providing AI assistants with access to type strain genome data, species information, 16S rDNA sequences, functional annotations, and more.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gctype-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gctype",
    "wdcm",
    "type-strains",
    "genome",
    "microbiology",
    "bacteria",
    "archaea",
    "fungi",
    "16s-rdna",
    "bioinformatics",
    "ai-assistant"
  ],
  "author": "gcType-MCP Contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZengZichao/gcType-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/ZengZichao/gcType-MCP/issues"
  },
  "homepage": "https://github.com/ZengZichao/gcType-MCP#readme"
}
